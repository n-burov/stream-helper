{
  "name": "stream-helper",
  "version": "1.3.1",
  "main": "electron-main.js",
  "author": "n-burov",
  "repository": {
    "type": "git",
    "url": "https://github.com/n-burov/stream-helper.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0",
    "tmi.js": "^1.8.5",
    "electron-updater": "^6.1.7",
    "electron-log": "^5.1.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.nburov.streamhelper",
    "productName": "Stream Helper",
    "directories": { "output": "dist" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Stream Helper"
    },
    "publish": [{
      "provider": "github",
      "owner": "n-burov",
      "repo": "stream-helper"
    }],
    "files": [
      "electron-main.js",
      "preload.js",
      "server.js",
      "auth.js",
      "db.js",
      "twitch.js",
      "twitch-eventsub.js",
      "twitch-api.js",
      "donationalerts.js",
      "donationalerts-auth.js",
      "mechanics/**/*",
      "public/**/*",
      "assets/**/*",
      "package.json"
    ]
  }
}
